{
  "name": "nail-salon-booking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:rls": "npx supabase db query --linked -f supabase/tests/rls-cross-tenant.sql",
    "test:booking-rpcs": "npx supabase db query --linked -f supabase/tests/booking-rpcs.sql",
    "test:staff-safeguards": "npx supabase db query --linked -f supabase/tests/staff-role-safeguards.sql",
    "test:db": "npm run test:rls && npm run test:booking-rpcs && npm run test:staff-safeguards"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@shadcn/react": "^0.3.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.31.0",
    "luxon": "^3.7.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "resend": "^6.20.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
