DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/nail_salon_booking

# Optional. Leave unset for local dev -- notifications log instead of
# sending. Requires Meta Business verification + a WhatsApp Business
# Cloud API phone number + approved message templates before use.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Optional locally (image uploads fall back to local disk under uploads/).
# REQUIRED on Vercel or anywhere else with a read-only filesystem at
# runtime -- get this from the Vercel dashboard's Storage tab after
# creating a Blob store.
# BLOB_READ_WRITE_TOKEN=
